# Keitaro
KEITARO_URL=https://tlgk.host
KEITARO_API_KEY=put-your-admin-api-key-here

# Database (SQLite by default; Postgres: postgresql+psycopg://user:pass@localhost/keitaro)
DATABASE_URL=sqlite:///./keitaro_wrapper.db

# Defaults pre-selected in the creator form (can be changed in the UI)
DEFAULT_DOMAIN_ID=1813
DEFAULT_GROUP_ID=9799
DEFAULT_TRAFFIC_SOURCE_ID=836

# Where stream #1 (the geo stream) sends visitors
GEO_REDIRECT_URL=https://www.google.com
